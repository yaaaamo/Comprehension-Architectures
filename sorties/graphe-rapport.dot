graph couplage {
  layout=neato; overlap=false; node [shape=box, fontname="Helvetica"];
  "LibraryApp";
  "Book";
  "Category";
  "Dvd";
  "Item";
  "Loanable";
  "Member";
  "Catalog";
  "ConsoleNotifier";
  "LoanException";
  "LoanService";
  "Loan";
  "Notifier";
  "Statistics";
  "TextUtils";
  "Item" -- "LoanService" [label="4", penwidth=9.0];
  "LoanService" -- "Loan" [label="4", penwidth=9.0];
  "LibraryApp" -- "Item" [label="3", penwidth=7.0];
  "LibraryApp" -- "Catalog" [label="3", penwidth=7.0];
  "LibraryApp" -- "LoanService" [label="3", penwidth=7.0];
  "LibraryApp" -- "Loan" [label="2", penwidth=5.0];
  "Item" -- "Member" [label="2", penwidth=5.0];
  "Item" -- "Catalog" [label="2", penwidth=5.0];
  "Member" -- "LoanService" [label="2", penwidth=5.0];
  "LoanService" -- "Notifier" [label="2", penwidth=5.0];
  "Statistics" -- "TextUtils" [label="2", penwidth=5.0];
  "LibraryApp" -- "Book" [label="1", penwidth=3.0];
  "LibraryApp" -- "Statistics" [label="1", penwidth=3.0];
  "Book" -- "Item" [label="1", penwidth=3.0];
  "Category" -- "Item" [label="1", penwidth=3.0];
  "Loanable" -- "LoanService" [label="1", penwidth=3.0];
  "Member" -- "ConsoleNotifier" [label="1", penwidth=3.0];
  "Catalog" -- "LoanService" [label="1", penwidth=3.0];
  "LoanService" -- "TextUtils" [label="1", penwidth=3.0];
}
